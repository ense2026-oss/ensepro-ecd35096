# ---- ตั้งค่า FaceScan Bridge ----
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง

# Bridge Token จากหน้า ตั้งค่า -> เชื่อมต่อ FaceScan -> แท็บ "Bridge Token" (กดสร้างแล้วคัดลอก)
BRIDGE_TOKEN=fsbt_xxxxxxxxxxxxxxxxxxxxxxxx

# URL ฐานของ Edge Functions (ไม่ต้องมี / ปิดท้าย)
FN_BASE=https://typckluzuzpxznrlrprq.supabase.co/functions/v1

# พอร์ตที่ใช้คุยกับเครื่อง (ZK มาตรฐาน = 4370) — ปกติไม่ต้องแก้
DEVICE_PORT=4370

# (ไม่บังคับ) timeout การเชื่อมต่อเครื่อง หน่วยมิลลิวินาที
ZK_TIMEOUT_MS=10000

# (ไม่บังคับ) รอบ poll เริ่มต้น หน่วยวินาที (ระบบอาจ override ให้)
POLL_SECONDS=30
